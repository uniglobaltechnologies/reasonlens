{
  "framework_id": "maturity-the",
  "framework_name": "THE Digital Maturity Index",
  "mapping_description": "Cross-framework mappings between THE DMI (20 child dimensions) and JISC AI Maturity Model (5 themes) and QS AI Capability Framework (4 pillars with 14 indicators). Mappings are at dimension level with many-to-one relationships documented.",
  "target_frameworks": [
    {
      "framework_id": "jisc-ai-maturity",
      "framework_name": "JISC AI Maturity Model",
      "version": "2024 (March update)",
      "structure": "5 stages x 5 themes",
      "themes": [
        {
          "id": "jisc-strategic",
          "name": "Strategic Adoption of AI",
          "description": "Institutional strategy and leadership for AI adoption"
        },
        {
          "id": "jisc-students",
          "name": "Students & Learners",
          "description": "Student-facing AI capabilities, learning experience, and student support"
        },
        {
          "id": "jisc-safe",
          "name": "Safe & Responsible Use",
          "description": "Ethics, governance, risk management, and responsible AI deployment"
        },
        {
